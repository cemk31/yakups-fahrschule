    "is_nestable": true
  },
  "reviews_section": {
    "name": "reviews_section",
    "display_name": "Reviews Section",
    "schema": {
      "tagline": {
        "type": "text",
        "display_name": "Tagline"
      },
      "averageRating": {
        "type": "text",
        "display_name": "Ø Bewertung",
        "default_value": "4,9"
      },
      "totalCount": {
        "type": "text",
        "display_name": "Anzahl-Text",
        "default_value": "Aus 87 verifizierten Google-Bewertungen"
      },
      "items": {
        "type": "bloks",
        "display_name": "Bewertungen",
        "restrict_components": true,
        "component_whitelist": [
          "review_item"
        ]
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "review_item": {
    "name": "review_item",
    "display_name": "Review Item",
    "schema": {
      "text": {
        "type": "textarea",
        "display_name": "Bewertungstext",
        "required": true
      },
      "author": {
        "type": "text",
        "display_name": "Autor",
        "required": true
      },
      "initials": {
        "type": "text",
        "display_name": "Initialen (2 Buchstaben)"
      },
      "context": {
        "type": "text",
        "display_name": "Kontext",
        "description": "z.B. 'Klasse CE · März 2026'"
      },
      "rating": {
        "type": "number",
        "display_name": "Sterne (1-5)",
        "default_value": 5
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "cta_section": {
    "name": "cta_section",
