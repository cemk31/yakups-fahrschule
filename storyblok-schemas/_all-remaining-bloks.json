{
  "lkw_spotlight": {
    "name": "lkw_spotlight",
    "display_name": "LKW Spotlight",
    "schema": {
      "tagline": {
        "type": "text",
        "display_name": "Tagline"
      },
      "headline": {
        "type": "text",
        "display_name": "Headline",
        "required": true
      },
      "headlineAccent": {
        "type": "text",
        "display_name": "Headline-Akzent (grün)"
      },
      "description": {
        "type": "textarea",
        "display_name": "Beschreibungstext"
      },
      "primaryCtaLabel": {
        "type": "text",
        "display_name": "Primärer CTA - Text"
      },
      "primaryCtaLink": {
        "type": "multilink",
        "display_name": "Primärer CTA - Link"
      },
      "secondaryCtaLabel": {
        "type": "text",
        "display_name": "Sekundärer CTA - Text"
      },
      "secondaryCtaLink": {
        "type": "multilink",
        "display_name": "Sekundärer CTA - Link"
      },
      "steps": {
        "type": "bloks",
        "display_name": "Schritte",
        "restrict_components": true,
        "component_whitelist": [
          "spotlight_step"
        ]
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "spotlight_step": {
    "name": "spotlight_step",
    "display_name": "Spotlight Step",
    "schema": {
      "title": {
        "type": "text",
        "display_name": "Titel",
        "required": true
      },
      "description": {
        "type": "textarea",
        "display_name": "Beschreibung"
      },
      "highlighted": {
        "type": "boolean",
        "display_name": "Hervorgehoben (grün)",
        "description": "Markiert den Endpunkt des Prozesses"
      },
      "spanFull": {
        "type": "boolean",
        "display_name": "Volle Breite",
        "description": "Über beide Spalten"
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "process_steps": {
    "name": "process_steps",
    "display_name": "Process Steps",
    "schema": {
      "tagline": {
        "type": "text",
        "display_name": "Tagline"
      },
      "headline": {
        "type": "text",
        "display_name": "Headline",
        "required": true
      },
      "headlineAccent": {
        "type": "text",
        "display_name": "Headline-Akzent (grün)"
      },
      "variant": {
        "type": "option",
        "display_name": "Variante",
        "options": [
          {
            "name": "Dunkel",
            "value": "dark"
          },
          {
            "name": "Hell",
            "value": "light"
          }
        ]
      },
      "steps": {
        "type": "bloks",
        "display_name": "Schritte",
        "restrict_components": true,
        "component_whitelist": [
          "process_step"
        ]
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "process_step": {
    "name": "process_step",
    "display_name": "Process Step",
    "schema": {
      "title": {
        "type": "text",
        "display_name": "Titel",
        "required": true
      },
      "description": {
        "type": "textarea",
        "display_name": "Beschreibung"
      },
      "duration": {
        "type": "text",
        "display_name": "Dauer",
        "description": "z.B. '~ 1 Woche'"
      },
      "highlighted": {
        "type": "boolean",
        "display_name": "Hervorgehoben (grün)"
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "pricing_table": {
    "name": "pricing_table",
    "display_name": "Pricing Table",
    "schema": {
      "tagline": {
        "type": "text",
        "display_name": "Tagline"
      },
      "headline": {
        "type": "text",
        "display_name": "Headline",
        "required": true
      },
      "description": {
        "type": "textarea",
        "display_name": "Beschreibung"
      },
      "columnLabels": {
        "type": "text",
        "display_name": "Spalten-Labels (komma-getrennt)",
        "default_value": "Klasse,Grundbetrag,Theorie,Praxis,Richtwert gesamt"
      },
      "rows": {
        "type": "bloks",
        "display_name": "Preiszeilen",
        "restrict_components": true,
        "component_whitelist": [
          "price_row"
        ]
      },
      "footnote": {
        "type": "textarea",
        "display_name": "Fußnote"
      },
      "promoBox": {
        "type": "bloks",
        "display_name": "Promo-Box (Förderung)",
        "maximum": 1,
        "restrict_components": true,
        "component_whitelist": [
          "promo_box"
        ]
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "price_row": {
    "name": "price_row",
    "display_name": "Price Row",
    "schema": {
      "licenseClass": {
        "type": "text",
        "display_name": "Klasse",
        "required": true
      },
      "basicFee": {
        "type": "text",
        "display_name": "Grundbetrag"
      },
      "theoryFee": {
        "type": "text",
        "display_name": "Theorie"
      },
      "practiceFee": {
        "type": "text",
        "display_name": "Praxis"
      },
      "totalFee": {
        "type": "text",
        "display_name": "Richtwert gesamt",
        "required": true
      },
      "highlighted": {
        "type": "boolean",
        "display_name": "Hervorgehoben"
      }
    },
    "is_root": false,
    "is_nestable": true
  },
  "promo_box": {
    "name": "promo_box",
