        "type": "multilink",
        "display_name": "Link"
      },
      "variant": {
        "type": "option",
        "display_name": "Variante",
        "required": true,
        "options": [
          {
            "name": "Schwarz",
            "value": "ink"
          },
          {
            "name": "Weiß",
            "value": "white"
          },
          {
            "name": "Outline",
            "value": "outline"
          }
        ]
      },
      "icon": {
        "type": "option",
        "display_name": "Icon",
        "options": [
          {
            "name": "Telefon",
            "value": "phone"
          },
          {
            "name": "WhatsApp",
            "value": "whatsapp"
          },
          {
            "name": "Pfeil",
            "value": "arrow"
          }
        ]
      }
    },
    "is_root": false,
    "is_nestable": true
  },
